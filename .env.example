# =================================================================
# TweetSupport AI Customer Support Agent - Environment Configuration
# =================================================================

# ---- Application ----
APP_ENV=development
DEBUG=false
JWT_SECRET=tweetsupport-dev-jwt-secret-key-32-chars-minimum-prod
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ---- Database (PostgreSQL 16 + pgvector) ----
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/tweetsupport
DATABASE_SYNC_URL=postgresql://app:app@localhost:5432/tweetsupport

# ---- LLM Provider (Local Ollama default, OpenAI / Mock adapters) ----
LLM_PROVIDER=ollama            # ollama | openai | mock
LLM_MODEL=llama3.2:3b          # llama3.2:3b | llama3.1:8b-instruct | gpt-4o-mini
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE_CLASSIFIER=0.0
LLM_TEMPERATURE_DRAFTER=0.3

# ---- LLM-as-Judge Provider (Evaluator model) ----
JUDGE_PROVIDER=ollama          # ollama | openai | mock
JUDGE_MODEL=qwen2.5:14b-instruct # qwen2.5:14b-instruct | gpt-4o

# ---- Optional Cloud Keys (If LLM_PROVIDER=openai) ----
OPENAI_API_KEY=

# ---- Retrieval & Embeddings ----
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_RETRIEVAL=3

# ---- Brand Configuration ----
BRAND=AppleSupport
SUBSAMPLE_SIZE=5000
GOLDEN_SET_SIZE=200
